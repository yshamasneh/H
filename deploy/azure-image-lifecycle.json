{
  "rules": [
    {
      "enabled": true,
      "name": "delete-abandoned-image-uploads",
      "type": "Lifecycle",
      "definition": {
        "actions": {
          "baseBlob": {
            "delete": {
              "daysAfterModificationGreaterThan": 1
            }
          }
        },
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": ["image-uploads/pending/"]
        }
      }
    }
  ]
}
