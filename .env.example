POSTGRES_USER=tasawaq
POSTGRES_PASSWORD=tasawaq_dev_password
POSTGRES_DB=tasawaq
DATABASE_URL="postgresql://tasawaq:tasawaq_dev_password@localhost:5432/tasawaq?schema=public"

NODE_ENV=development
APP_VERSION=0.8.0
PORT=3000
CORS_ORIGIN=*
TRUST_PROXY=false
REQUIRE_HTTPS=false
LOG_LEVEL=debug
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=60

# Postgres connection-pool size for this API instance (pg driver default is only 10). Tune to
# min(cores * 2, postgres_max_connections / api_instances). 0 timeout = wait for a free connection.
DATABASE_POOL_MAX=20
DATABASE_POOL_CONNECTION_TIMEOUT_MS=0
# Interactive-transaction ceiling (Prisma's own default is only 5000ms). Raise if checkouts hard-fail
# under load; lower to abort stuck transactions sooner.
DATABASE_TRANSACTION_TIMEOUT_MS=10000
DATABASE_TRANSACTION_MAX_WAIT_MS=5000

# The restaurant vertical is built and tested but not launched yet (customers see a "coming soon"
# card). Gates public restaurant browsing/menu endpoints and restaurant order creation. Flip to
# true to launch restaurants — no rebuild required. Never affects supermarket ordering.
RESTAURANT_ORDERING_ENABLED=false

# Delivery pricing in minor ILS units/meters. The minimum covers the included distance.
DELIVERY_MIN_FEE_MINOR=1000
DELIVERY_INCLUDED_DISTANCE_METERS=3000
DELIVERY_RATE_PER_KM_MINOR=150
DELIVERY_MAX_DISTANCE_METERS=25000

# Generate unique random values for local development. Never commit real secrets.
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_DAYS=30

OTP_PROVIDER=development
OTP_HASH_SECRET=replace_with_a_third_random_secret_at_least_32_characters
# Where this process is running: local | trial | production. NODE_ENV is not a reliable answer —
# the Azure trial runs the production image with NODE_ENV=development on purpose — so anything
# reachable from the internet should say so here. Azure App Service is also detected automatically
# from the WEBSITE_SITE_NAME it injects.
DEPLOYMENT_ENV=local
# Refuse to boot if a deployed environment selects the log-only development provider, whose codes
# only ever reach the application log. Leave false locally; set it to true on anything deployed.
OTP_REQUIRE_REAL_PROVIDER=false
OTP_EXPIRATION_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Cost ceilings for a paid SMS gateway: codes per number per rolling day, and platform-wide per
# rolling day. Sized so a real person retrying never meets them; they exist to bound the bill.
OTP_MAX_PER_PHONE_PER_DAY=10
OTP_MAX_GLOBAL_PER_DAY=2000
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=10

# Optional locally. OTP_PROVIDER=webhook requires all three values.
# OTP_WEBHOOK_URL=https://messaging.example.com/v1/otp
# OTP_WEBHOOK_TOKEN=replace_with_a_random_token_at_least_32_characters
OTP_WEBHOOK_TIMEOUT_MS=5000

# TweetSMS (tweetsms.ps) — the real SMS gateway. Server-side only: these values must never be
# given an EXPO_PUBLIC_ or VITE_ prefix and must never be sent to a mobile or web client.
# Set OTP_PROVIDER=tweetsms to use it. Leaving it unset keeps every environment away from the
# gateway; no code path reaches TweetSMS unless OTP_PROVIDER says so.
# See docs/tweetsms-otp-readiness.md, including the preflight that prints the request without
# sending it: npm run otp:tweetsms:preflight --workspace @wasel/api -- +970591234567
# TWEETSMS_API_KEY=replace_with_the_tweetsms_api_key
# TWEETSMS_SENDER=replace_with_the_sender_name_approved_by_tweetsms
# Defaults to the documented endpoint; HTTPS is required because the key is in the request body.
# TWEETSMS_BASE_URL=https://tweetsms.ps/api.php/maan/sendsms
# TWEETSMS_TIMEOUT_MS=8000
# Unverified with the live gateway, hence configurable: digits = 970591234567 (default),
# e164 = +970591234567, local = 0591234567.
# TWEETSMS_RECIPIENT_FORMAT=digits
# Must contain {{code}} and render within 160 characters. ASCII by default: Arabic/UCS-2 handling
# by this gateway has not been verified.
# TWEETSMS_MESSAGE_TEMPLATE=JOVO verification code: {{code}}. Do not share it.
# Sends the collection's optional groups/date/time fields as empty strings. Off unless the
# provider turns out to reject a request without them.
# TWEETSMS_SEND_OPTIONAL_FIELDS=false

# Protects GET /api/v1/metrics. Leave empty to disable that endpoint locally.
MONITORING_TOKEN=
# ERROR_TRACKING_WEBHOOK_URL=https://errors.example.com/v1/events
# ERROR_TRACKING_TOKEN=replace_with_a_random_token_at_least_32_characters
ERROR_TRACKING_TIMEOUT_MS=3000

# Road routes for the driver's map (any OSRM-compatible service); one request per delivery, cached.
ROUTING_ENABLED=true
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=4000
# A driver is alerted only while their app is running. The app renews a lease by heartbeat while
# open (foreground) and reports once when it goes to the background, which buys a longer grace.
DRIVER_PRESENCE_FOREGROUND_LEASE_SECONDS=120
DRIVER_PRESENCE_BACKGROUND_GRACE_MINUTES=30
# Durable PostgreSQL-backed Expo delivery worker. Each API instance may run it: row claims prevent
# two instances from processing the same delivery concurrently. At least one production instance
# must keep the worker enabled.
PUSH_WORKER_ENABLED=true
PUSH_WORKER_POLL_INTERVAL_MS=5000
PUSH_WORKER_MAX_BATCHES_PER_RUN=10
PUSH_PROVIDER_TIMEOUT_MS=5000
PUSH_PROCESSING_STALE_MS=120000
PUSH_MAX_ATTEMPTS=6
PUSH_MAX_RECEIPT_ATTEMPTS=10
PUSH_RECEIPT_DELAY_MS=60000
PUSH_RETRY_BASE_MS=5000
PUSH_RETRY_MAX_MS=900000

# For Android emulator use http://10.0.2.2:3000.
# For iOS simulator use http://localhost:3000.
# For a real phone use http://YOUR_COMPUTER_LAN_IP:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Public application images. DefaultAzureCredential uses the signed-in Azure CLI account locally;
# deployed instances use the App Service managed identity. Never add an account key or SAS here.
# Configure all three together. They are mandatory when NODE_ENV=production.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_PUBLIC_CONTAINER_NAME=
AZURE_STORAGE_UPLOAD_CONTAINER_NAME=
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_SAS_TTL_SECONDS=300
