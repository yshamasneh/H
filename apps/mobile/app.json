{
  "expo": {
    "name": "JOVO",
    "slug": "jovo",
    "version": "0.17.0",
    "scheme": "jovo",
    "icon": "./assets/store/app-icon-1024.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jovo.app",
      "buildNumber": "17",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1", "1C8F.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          }
        ]
      }
    },
    "locales": {
      "ar": "./native-locales/ar.json",
      "en": "./native-locales/en.json"
    },
    "android": {
      "package": "com.jovo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/store/adaptive-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "versionCode": 17,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logo/jovo-mark.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/store/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JOVO uses your location while the app is open: customers can pin their delivery address to check delivery availability and the delivery fee, and drivers share their position with JOVO dispatch to receive and complete deliveries.",
          "locationAlwaysAndWhenInUsePermission": "Drivers only: during an active delivery, JOVO shares your location with JOVO dispatch even when the app is closed or in the background, for example while you use a navigation app. Nothing is collected in the background when you have no delivery.",
          "locationAlwaysPermission": "Drivers only: during an active delivery, JOVO shares your location with JOVO dispatch even when the app is closed or in the background. Nothing is collected in the background when you have no delivery.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "JOVO opens your photos only when store staff choose a product image to upload.",
          "cameraPermission": "JOVO opens the camera only when store staff choose to take a product photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/jovo_delivery.wav", "./assets/sounds/jovo_order.wav"]
        }
      ],
      "expo-localization",
      "@maplibre/maplibre-react-native",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/46a8fe97-9509-4e20-b8b5-a2b11ba6d2e7",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "46a8fe97-9509-4e20-b8b5-a2b11ba6d2e7"
      }
    },
    "owner": "mohammadsham00"
  }
}
