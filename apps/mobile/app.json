{
  "expo": {
    "name": "JOVO",
    "slug": "jovo",
    "version": "0.16.0",
    "scheme": "jovo",
    "icon": "./assets/store/app-icon-1024.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jovo.app",
      "buildNumber": "15",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jovo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/store/adaptive-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "versionCode": 16,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logo/jovo-mark.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/store/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JOVO uses your location only when you choose it to calculate delivery availability and pricing.",
          "locationAlwaysAndWhenInUsePermission": "During an active delivery, JOVO shares your location with JOVO dispatch even when the app is closed or in the background, for example while you use a navigation app. It is not collected when you have no delivery.",
          "locationAlwaysPermission": "During an active delivery, JOVO shares your location with JOVO dispatch even when the app is closed or in the background. It is not collected when you have no delivery.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "JOVO accesses your photos only when you choose an image to upload.",
          "cameraPermission": "JOVO accesses the camera only when you choose to take an image.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/jovo_delivery.wav"]
        }
      ],
      "expo-localization",
      "@maplibre/maplibre-react-native",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/46a8fe97-9509-4e20-b8b5-a2b11ba6d2e7",
      "fallbackToCacheTimeout": 30000
    },
    "extra": {
      "eas": {
        "projectId": "46a8fe97-9509-4e20-b8b5-a2b11ba6d2e7"
      }
    },
    "owner": "mohammadsham00"
  }
}
