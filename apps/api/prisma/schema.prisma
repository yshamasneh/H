generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  RESTAURANT
  DRIVER
  ADMIN
}

enum OtpPurpose {
  CUSTOMER_SIGNUP
  PASSWORD_RESET
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DriverApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_STATUS_CHANGED
  DELIVERY_ASSIGNED
  DELIVERY_STATUS_CHANGED
  RESTAURANT_APPROVED
  RESTAURANT_REJECTED
  RESTAURANT_SUSPENDED
  DRIVER_APPROVED
  DRIVER_REJECTED
  DRIVER_SUSPENDED
  ADMIN_ALERT
}

enum OrderPaymentMethod {
  CASH
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  DELIVERED
  REJECTED
  CANCELLED
}

enum DeliveryStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  fullName            String
  phone               String               @unique
  email               String?              @unique
  passwordHash        String
  role                UserRole
  phoneVerifiedAt     DateTime?
  isActive            Boolean              @default(true)
  tokenVersion        Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  refreshSessions     RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  restaurant          Restaurant?
  orders              Order[]
  orderStatusChanges  OrderStatusHistory[]
  driverProfile       DriverProfile?
  deliveriesAsDriver  Delivery[]
  auditLogs           AuditLog[]
  notifications       Notification[]

  @@index([role, isActive])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PhoneVerificationChallenge {
  id                String     @id @default(uuid()) @db.Uuid
  phone             String
  purpose           OtpPurpose
  codeHash          String
  expiresAt         DateTime
  attemptCount      Int        @default(0)
  maxAttempts       Int
  resendAvailableAt DateTime
  consumedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

model PendingCustomerRegistration {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String
  phone        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
}

model Restaurant {
  id          String           @id @default(uuid()) @db.Uuid
  ownerUserId String           @unique @db.Uuid
  name        String
  description String?
  phone       String
  status      RestaurantStatus @default(PENDING)
  isOpen      Boolean          @default(false)
  addressLine String
  logoUrl     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  owner       User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  categories  MenuCategory[]
  items       MenuItem[]
  orders      Order[]

  @@index([status, isOpen])
}

model MenuCategory {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @db.Uuid
  name         String
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@index([restaurantId, sortOrder])
}

model MenuItem {
  id           String       @id @default(uuid()) @db.Uuid
  restaurantId String       @db.Uuid
  categoryId   String       @db.Uuid
  name         String
  description  String?
  priceMinor   Int
  imageUrl     String?
  isAvailable  Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@index([restaurantId, isAvailable])
  @@index([categoryId])
}

model Order {
  id                  String               @id @default(uuid()) @db.Uuid
  customerId          String               @db.Uuid
  restaurantId        String               @db.Uuid
  status              OrderStatus          @default(PLACED)
  paymentMethod       OrderPaymentMethod
  deliveryLabel       String
  deliveryAddressLine String
  deliveryLatitude    Float?
  deliveryLongitude   Float?
  subtotalMinor       Int
  deliveryFeeMinor    Int
  serviceFeeMinor     Int
  discountMinor       Int                  @default(0)
  totalMinor          Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  customer            User                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  delivery            Delivery?

  @@index([customerId, createdAt])
  @@index([restaurantId, createdAt])
}

model OrderStatusHistory {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String       @db.Uuid
  note            String?
  createdAt       DateTime     @default(now())
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy       User         @relation(fields: [changedByUserId], references: [id])

  @@index([orderId, createdAt])
}

model OrderItem {
  id                 String   @id @default(uuid()) @db.Uuid
  orderId            String   @db.Uuid
  menuItemId         String   @db.Uuid
  nameSnapshot       String
  priceMinorSnapshot Int
  quantity           Int
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem           MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}

model DriverProfile {
  userId        String               @id @db.Uuid
  status        DriverApprovalStatus @default(PENDING)
  isOnline      Boolean              @default(false)
  lastLatitude  Float?
  lastLongitude Float?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, isOnline])
}

model Delivery {
  id          String         @id @default(uuid()) @db.Uuid
  orderId     String         @unique @db.Uuid
  driverId    String?        @db.Uuid
  status      DeliveryStatus @default(PENDING_ASSIGNMENT)
  assignedAt  DateTime?
  pickedUpAt  DateTime?
  onTheWayAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver      User?          @relation(fields: [driverId], references: [id])

  @@index([status, driverId])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String   @db.Uuid
  action       String
  entityType   String
  entityId     String
  reason       String?
  metadataJson Json?
  createdAt    DateTime @default(now())
  actor        User     @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  type            NotificationType
  title           String
  body            String
  relatedEntityId String?          @db.Uuid
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}
