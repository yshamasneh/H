generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  RESTAURANT
  DRIVER
  ADMIN
}

enum OtpPurpose {
  CUSTOMER_SIGNUP
  PASSWORD_RESET
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DriverApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_STATUS_CHANGED
  DELIVERY_ASSIGNED
  DELIVERY_STATUS_CHANGED
  RESTAURANT_APPROVED
  RESTAURANT_REJECTED
  RESTAURANT_SUSPENDED
  DRIVER_APPROVED
  DRIVER_REJECTED
  DRIVER_SUSPENDED
  ADMIN_ALERT
}

enum OrderPaymentMethod {
  CASH
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  DELIVERED
  REJECTED
  CANCELLED
}

enum DeliveryStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum OfferType {
  PRODUCT_PERCENTAGE
  ORDER_PERCENTAGE
  DELIVERY_PERCENTAGE
  FREE_DELIVERY
}

enum BusinessType {
  RESTAURANT
  SUPERMARKET
}

enum FulfillmentAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventoryMovementType {
  ORDER_RESERVATION
  ORDER_RESTORE
  FULFILLMENT_RESERVATION
  FULFILLMENT_RELEASE
  MANUAL_ADJUSTMENT
  PURCHASE_RECEIPT
}

enum PurchaseOrderStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

model User {
  id                    String                  @id @default(uuid()) @db.Uuid
  fullName              String
  phone                 String                  @unique
  email                 String?                 @unique
  passwordHash          String
  role                  UserRole
  phoneVerifiedAt       DateTime?
  isActive              Boolean                 @default(true)
  tokenVersion          Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  refreshSessions       RefreshSession[]
  passwordResetTokens   PasswordResetToken[]
  restaurant            Restaurant?
  orders                Order[]
  orderStatusChanges    OrderStatusHistory[]
  driverProfile         DriverProfile?
  deliveriesAsDriver    Delivery[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  offersCreated         Offer[]                 @relation("OfferCreatedBy")
  fulfillmentProposals  FulfillmentAdjustment[] @relation("FulfillmentProposedBy")
  inventoryMovements    InventoryMovement[]     @relation("InventoryMovementActor")
  purchaseOrdersCreated PurchaseOrder[]         @relation("PurchaseOrderCreatedBy")
  addresses             Address[]
  pushTokens            PushToken[]

  @@index([role, isActive])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PhoneVerificationChallenge {
  id                String     @id @default(uuid()) @db.Uuid
  phone             String
  purpose           OtpPurpose
  codeHash          String
  expiresAt         DateTime
  attemptCount      Int        @default(0)
  maxAttempts       Int
  resendAvailableAt DateTime
  consumedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

model PendingCustomerRegistration {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String
  phone        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  label       String
  addressLine String
  latitude    Float
  longitude   Float
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault, createdAt])
}

model PushToken {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  token            String   @unique
  platform         String
  isActive         Boolean  @default(true)
  lastRegisteredAt DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model Restaurant {
  id                 String              @id @default(uuid()) @db.Uuid
  ownerUserId        String              @unique @db.Uuid
  name               String
  businessType       BusinessType        @default(RESTAURANT)
  description        String?
  phone              String
  status             RestaurantStatus    @default(PENDING)
  isOpen             Boolean             @default(false)
  addressLine        String
  latitude           Float?
  longitude          Float?
  logoUrl            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  owner              User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  categories         MenuCategory[]
  items              MenuItem[]
  offers             Offer[]
  orders             Order[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  inventoryMovements InventoryMovement[]

  @@index([businessType, status, isOpen])
}

model Offer {
  id                   String      @id @default(uuid()) @db.Uuid
  type                 OfferType   @default(ORDER_PERCENTAGE)
  restaurantId         String?     @db.Uuid
  menuItemId           String?     @db.Uuid
  createdByUserId      String?     @db.Uuid
  title                String
  description          String?
  discountPercent      Int?
  minimumSubtotalMinor Int         @default(0)
  maxDiscountMinor     Int?
  imageUrl             String?
  startsAt             DateTime    @default(now())
  endsAt               DateTime?
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  restaurant           Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItem             MenuItem?   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdBy            User?       @relation("OfferCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([isActive, startsAt, endsAt])
  @@index([type, isActive, startsAt, endsAt])
  @@index([restaurantId])
  @@index([menuItemId])
}

model MenuCategory {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @db.Uuid
  name         String
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@index([restaurantId, sortOrder])
}

model MenuItem {
  id                     String                  @id @default(uuid()) @db.Uuid
  restaurantId           String                  @db.Uuid
  categoryId             String                  @db.Uuid
  name                   String
  description            String?
  priceMinor             Int
  imageUrl               String?
  sku                    String?
  brand                  String?
  unitLabel              String                  @default("item")
  stockQuantity          Int?
  isFeatured             Boolean                 @default(false)
  isVariableWeight       Boolean                 @default(false)
  barcode                String?
  reorderLevel           Int?
  isAvailable            Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  restaurant             Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category               MenuCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems             OrderItem[]
  replacementAdjustments FulfillmentAdjustment[] @relation("ReplacementMenuItem")
  offers                 Offer[]
  inventoryMovements     InventoryMovement[]
  purchaseOrderItems     PurchaseOrderItem[]

  @@unique([restaurantId, sku])
  @@unique([restaurantId, barcode])
  @@index([restaurantId, isAvailable])
  @@index([categoryId])
  @@index([restaurantId, isFeatured, isAvailable])
}

model Order {
  id                     String               @id @default(uuid()) @db.Uuid
  customerId             String               @db.Uuid
  restaurantId           String               @db.Uuid
  status                 OrderStatus          @default(PLACED)
  paymentMethod          OrderPaymentMethod
  deliveryLabel          String
  deliveryAddressLine    String
  deliveryLatitude       Float?
  deliveryLongitude      Float?
  deliveryDistanceMeters Int?
  subtotalMinor          Int
  deliveryFeeMinor       Int
  serviceFeeMinor        Int
  discountMinor          Int                  @default(0)
  promotionSnapshot      Json?
  customerNote           String?
  totalMinor             Int
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  customer               User                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant             Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items                  OrderItem[]
  statusHistory          OrderStatusHistory[]
  delivery               Delivery?
  inventoryMovements     InventoryMovement[]

  @@index([customerId, createdAt])
  @@index([restaurantId, createdAt])
}

model OrderStatusHistory {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String       @db.Uuid
  note            String?
  createdAt       DateTime     @default(now())
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy       User         @relation(fields: [changedByUserId], references: [id])

  @@index([orderId, createdAt])
}

model OrderItem {
  id                       String                 @id @default(uuid()) @db.Uuid
  orderId                  String                 @db.Uuid
  menuItemId               String                 @db.Uuid
  nameSnapshot             String
  priceMinorSnapshot       Int
  quantity                 Int
  unitLabelSnapshot        String                 @default("item")
  allowSubstitution        Boolean                @default(false)
  isVariableWeightSnapshot Boolean                @default(false)
  order                    Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem                 MenuItem               @relation(fields: [menuItemId], references: [id])
  fulfillmentAdjustment    FulfillmentAdjustment?

  @@index([orderId])
}

model FulfillmentAdjustment {
  id                           String                      @id @default(uuid()) @db.Uuid
  orderItemId                  String                      @unique @db.Uuid
  replacementMenuItemId        String?                     @db.Uuid
  proposedByUserId             String                      @db.Uuid
  replacementNameSnapshot      String?
  replacementUnitLabelSnapshot String?
  actualQuantityMilli          Int
  unitPriceMinor               Int
  lineTotalMinor               Int
  status                       FulfillmentAdjustmentStatus @default(PENDING)
  note                         String?
  decidedAt                    DateTime?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  orderItem                    OrderItem                   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  replacementMenuItem          MenuItem?                   @relation("ReplacementMenuItem", fields: [replacementMenuItemId], references: [id], onDelete: SetNull)
  proposedBy                   User                        @relation("FulfillmentProposedBy", fields: [proposedByUserId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  restaurantId  String                @db.Uuid
  menuItemId    String                @db.Uuid
  actorUserId   String?               @db.Uuid
  orderId       String?               @db.Uuid
  type          InventoryMovementType
  quantityDelta Int
  stockAfter    Int
  reason        String?
  createdAt     DateTime              @default(now())
  restaurant    Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItem      MenuItem              @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  actor         User?                 @relation("InventoryMovementActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  order         Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([menuItemId, createdAt])
  @@index([orderId])
}

model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  restaurantId   String          @db.Uuid
  name           String
  phone          String?
  note           String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([restaurantId, isActive, name])
}

model PurchaseOrder {
  id              String              @id @default(uuid()) @db.Uuid
  restaurantId    String              @db.Uuid
  supplierId      String              @db.Uuid
  createdByUserId String              @db.Uuid
  status          PurchaseOrderStatus @default(DRAFT)
  reference       String?
  note            String?
  totalCostMinor  Int                 @default(0)
  receivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  restaurant      Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  createdBy       User                @relation("PurchaseOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  items           PurchaseOrderItem[]

  @@index([restaurantId, status, createdAt])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  menuItemId      String        @db.Uuid
  quantity        Int
  unitCostMinor   Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id])

  @@unique([purchaseOrderId, menuItemId])
  @@index([menuItemId])
}

model DriverProfile {
  userId        String               @id @db.Uuid
  status        DriverApprovalStatus @default(PENDING)
  isOnline      Boolean              @default(false)
  lastLatitude  Float?
  lastLongitude Float?
  lastLocationAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, isOnline])
}

model Delivery {
  id          String         @id @default(uuid()) @db.Uuid
  orderId     String         @unique @db.Uuid
  driverId    String?        @db.Uuid
  status      DeliveryStatus @default(PENDING_ASSIGNMENT)
  assignedAt  DateTime?
  pickedUpAt  DateTime?
  onTheWayAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver      User?          @relation(fields: [driverId], references: [id])

  @@index([status, driverId])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String   @db.Uuid
  action       String
  entityType   String
  entityId     String
  reason       String?
  metadataJson Json?
  createdAt    DateTime @default(now())
  actor        User     @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  type            NotificationType
  title           String
  body            String
  relatedEntityId String?          @db.Uuid
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}
