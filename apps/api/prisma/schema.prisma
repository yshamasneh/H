generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  RESTAURANT
  DRIVER
  ADMIN
}

enum OtpPurpose {
  CUSTOMER_SIGNUP
  PASSWORD_RESET
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  fullName            String
  phone               String               @unique
  email               String?              @unique
  passwordHash        String
  role                UserRole
  phoneVerifiedAt     DateTime?
  isActive            Boolean              @default(true)
  tokenVersion        Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  refreshSessions     RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  restaurant          Restaurant?

  @@index([role, isActive])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PhoneVerificationChallenge {
  id                String     @id @default(uuid()) @db.Uuid
  phone             String
  purpose           OtpPurpose
  codeHash          String
  expiresAt         DateTime
  attemptCount      Int        @default(0)
  maxAttempts       Int
  resendAvailableAt DateTime
  consumedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

model PendingCustomerRegistration {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String
  phone        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
}

model Restaurant {
  id           String           @id @default(uuid()) @db.Uuid
  ownerUserId  String           @unique @db.Uuid
  name         String
  description  String?
  phone        String
  status       RestaurantStatus @default(PENDING)
  isOpen       Boolean          @default(false)
  addressLine  String
  logoUrl      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  owner        User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  categories   MenuCategory[]
  items        MenuItem[]

  @@index([status, isOpen])
}

model MenuCategory {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @db.Uuid
  name         String
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@index([restaurantId, sortOrder])
}

model MenuItem {
  id           String       @id @default(uuid()) @db.Uuid
  restaurantId String       @db.Uuid
  categoryId   String       @db.Uuid
  name         String
  description  String?
  priceMinor   Int
  imageUrl     String?
  isAvailable  Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([restaurantId, isAvailable])
  @@index([categoryId])
}
