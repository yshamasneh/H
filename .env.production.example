# Copy to .env.production, replace every placeholder, and keep that file out of Git.
NODE_ENV=production
APP_VERSION=0.8.0
PORT=3000
LOG_LEVEL=log

# Trading timezone. Store opening/closing hours are evaluated against the server's local wall
# clock, so a container left on UTC would open and close every store 2-3 hours late.
TZ=Asia/Hebron

# The restaurant vertical is built and tested but not launched. Leave false to launch with
# JOVO MARKET only; flip to true to open restaurant browsing and ordering, no rebuild required.
RESTAURANT_ORDERING_ENABLED=false

# Use a PostgreSQL role dedicated to this application. Require TLS when the provider supports it.
DATABASE_URL=postgresql://APP_USER:URL_ENCODED_PASSWORD@DB_HOST:5432/APP_DATABASE?schema=public&sslmode=require

# Exact public HTTPS origins only, comma-separated. Wildcards are rejected in production.
PUBLIC_APP_URL=https://app.example.com
EXPO_PUBLIC_API_URL=https://app.example.com
# The admin console's own public origin (a distinct subdomain, or a distinct port on the same
# domain). Its nginx proxies /api/ and /socket.io/ to the api container itself, so browser
# requests from the console stay same-origin; this is only needed at Vite build time so the
# bundled JS knows its own base URL, and here so it can also be allowlisted below.
ADMIN_APP_URL=https://admin.example.com
CORS_ORIGIN=https://app.example.com,https://admin.example.com
TRUST_PROXY=1
REQUIRE_HTTPS=true
# Host ports for the admin console's nginx (change if 8080/8443 collide with something else on
# the host). Point admin.example.com's DNS at this host and route to the HTTPS port.
ADMIN_HTTP_PORT=8080
ADMIN_HTTPS_PORT=8443
# Optional: a separate certificate for the admin console's domain. Defaults to the same
# certificate as TLS_CERTIFICATE_PATH/TLS_PRIVATE_KEY_PATH, which only works if that
# certificate already covers ADMIN_APP_URL's host (e.g. a wildcard cert).
# ADMIN_TLS_CERTIFICATE_PATH=./secrets/admin-fullchain.pem
# ADMIN_TLS_PRIVATE_KEY_PATH=./secrets/admin-privkey.pem

# Generate independent cryptographically random values of at least 32 characters.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_REFRESH_SECRET
OTP_HASH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_OTP_HASH_SECRET
# local | trial | production. Say `trial` on the Azure trial, which deliberately runs with
# NODE_ENV=development, so the log-only OTP provider is recognised as unacceptable there too.
DEPLOYMENT_ENV=production
# Refuse to boot if a deployed environment selects the log-only development OTP provider.
OTP_REQUIRE_REAL_PROVIDER=true
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_DAYS=30

# How verification codes reach customers. Exactly one of the two blocks below applies, and a
# deployed environment must use one of them: NODE_ENV=production refuses to boot with the
# development provider, which only writes the code to the server log.
#
# 1) TweetSMS (tweetsms.ps) — the live SMS gateway. Server-side only: never expose these values to
#    a mobile or web client, and never give them an EXPO_PUBLIC_ or VITE_ prefix.
#    Read docs/tweetsms-otp-readiness.md before the first live send.
OTP_PROVIDER=tweetsms
TWEETSMS_API_KEY=REPLACE_WITH_THE_TWEETSMS_API_KEY
TWEETSMS_SENDER=REPLACE_WITH_THE_SENDER_NAME_APPROVED_BY_TWEETSMS
# The documented endpoint. HTTPS is required: the API key travels in the request body.
TWEETSMS_BASE_URL=https://tweetsms.ps/api.php/maan/sendsms
TWEETSMS_TIMEOUT_MS=8000
# Unverified against the live gateway, hence configurable rather than compiled in:
# digits = 970591234567 (default), e164 = +970591234567, local = 0591234567.
TWEETSMS_RECIPIENT_FORMAT=digits
# Must contain {{code}} and render within 160 characters. ASCII by default; this gateway's handling
# of Arabic/UCS-2 text has not been verified.
TWEETSMS_MESSAGE_TEMPLATE=JOVO verification code: {{code}}. Do not share it.
# Sends the collection's optional groups/date/time fields as empty strings. Leave false unless the
# provider rejects a request that omits them.
TWEETSMS_SEND_OPTIONAL_FIELDS=false

# 2) Vendor-neutral OTP bridge, if an intermediary owns the provider integration instead. It
#    receives { phone, purpose, code } over HTTPS. Set OTP_PROVIDER=webhook to use this instead.
# OTP_WEBHOOK_URL=https://messaging.example.com/v1/otp
# OTP_WEBHOOK_TOKEN=REPLACE_WITH_RANDOM_OTP_WEBHOOK_TOKEN
OTP_WEBHOOK_TIMEOUT_MS=5000
OTP_EXPIRATION_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Cost ceilings for a paid SMS gateway: codes per number per rolling day, and platform-wide per
# rolling day. Sized so a real person retrying never meets them; they exist to bound the bill.
OTP_MAX_PER_PHONE_PER_DAY=10
OTP_MAX_GLOBAL_PER_DAY=2000
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=10

# CGNAT is heavy on Palestinian mobile carriers, so many customers can share one public IP;
# a low per-IP limit would throttle unrelated customers against each other. 400 is per IP per
# RATE_LIMIT_TTL_MS window (60s here) — raise further if a single deployment serves a very
# CGNAT-dense carrier segment.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=400

# Postgres connection-pool size PER API instance. The pg driver default is only 10, which caps
# throughput badly under load (see load-tests/RESULTS.md). Set to min(cores * 2, Postgres
# max_connections / number_of_api_instances) and keep the sum across all instances comfortably
# below Postgres max_connections. DATABASE_POOL_CONNECTION_TIMEOUT_MS > 0 makes requests fail fast
# instead of queueing indefinitely when the pool is exhausted (0 = wait, the pg default).
DATABASE_POOL_MAX=20
DATABASE_POOL_CONNECTION_TIMEOUT_MS=0
# Interactive-transaction ceiling. Prisma's own default (5000ms) hard-fails checkouts that run long
# under hot-product contention (load testing saw a small fraction abort at ~5s). 10s is more
# forgiving while still bounding a stuck transaction; MAX_WAIT is how long a transaction waits to
# open before giving up (Prisma default 2000ms).
DATABASE_TRANSACTION_TIMEOUT_MS=10000
DATABASE_TRANSACTION_MAX_WAIT_MS=5000

# Delivery pricing in minor ILS units/meters. Review these business values before launch.
DELIVERY_MIN_FEE_MINOR=1000
DELIVERY_INCLUDED_DISTANCE_METERS=3000
DELIVERY_RATE_PER_KM_MINOR=150
DELIVERY_MAX_DISTANCE_METERS=25000

# Prometheus-compatible /api/v1/metrics endpoint and generic error-tracking bridge.
MONITORING_TOKEN=REPLACE_WITH_RANDOM_MONITORING_TOKEN
ERROR_TRACKING_WEBHOOK_URL=https://errors.example.com/v1/events
ERROR_TRACKING_TOKEN=REPLACE_WITH_RANDOM_ERROR_TRACKING_TOKEN

# Road routes for the driver's map (any OSRM-compatible service). The public demo server is fine for a trial;
# self-host OSRM or use a paid provider before real launch. One request is made per delivery and cached.
ROUTING_ENABLED=true
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=4000
# A driver is alerted only while their app is running: foreground heartbeat lease, and a longer grace after
# the app goes to the background.
DRIVER_PRESENCE_FOREGROUND_LEASE_SECONDS=120
DRIVER_PRESENCE_BACKGROUND_GRACE_MINUTES=30
# Durable Expo delivery worker. Safe on multiple API instances because PostgreSQL claims each row.
# Keep enabled on at least one instance and alert on the pending/permanent-failure metrics.
PUSH_WORKER_ENABLED=true
PUSH_WORKER_POLL_INTERVAL_MS=5000
PUSH_WORKER_MAX_BATCHES_PER_RUN=10
PUSH_PROVIDER_TIMEOUT_MS=5000
PUSH_PROCESSING_STALE_MS=120000
PUSH_MAX_ATTEMPTS=6
PUSH_MAX_RECEIPT_ATTEMPTS=10
PUSH_RECEIPT_DELAY_MS=60000
PUSH_RETRY_BASE_MS=5000
PUSH_RETRY_MAX_MS=900000
ERROR_TRACKING_TIMEOUT_MS=3000

# Host paths mounted read-only into the TLS reverse proxy.
TLS_CERTIFICATE_PATH=./secrets/fullchain.pem
TLS_PRIVATE_KEY_PATH=./secrets/privkey.pem

# Backup policy used by npm run db:backup.
BACKUP_DIRECTORY=./backups
BACKUP_RETENTION_DAYS=14

# Public application images. Authentication is through the App Service managed identity and RBAC;
# do not add Storage account keys, connection strings, or SAS tokens.
AZURE_STORAGE_ACCOUNT_NAME=REPLACE_WITH_STORAGE_ACCOUNT_NAME
AZURE_STORAGE_PUBLIC_CONTAINER_NAME=product-images
AZURE_STORAGE_UPLOAD_CONTAINER_NAME=image-uploads
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_SAS_TTL_SECONDS=300
